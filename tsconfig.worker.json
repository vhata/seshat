{
  // The Worker, the Durable Object and shared logic, without their tests.
  // Runtime and binding types come from worker-configuration.d.ts, which
  // `npm run typegen` generates from wrangler.jsonc.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "lib": ["ES2024"],
    "types": []
  },
  "include": [
    "worker-configuration.d.ts",
    "src/worker",
    "src/object",
    "src/shared"
  ],
  "exclude": ["**/*.test.ts"]
}
