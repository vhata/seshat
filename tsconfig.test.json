{
  // Tests of the Worker, the Durable Object and shared logic. Only these see
  // the test-only `cloudflare:test` module.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "lib": ["ES2024"],
    "types": ["@cloudflare/vitest-plugin/types"]
  },
  "include": [
    "worker-configuration.d.ts",
    "src/worker/**/*.test.ts",
    "src/object/**/*.test.ts",
    "src/shared/**/*.test.ts"
  ]
}
